        "jsonBody": "={{ { summary: 'ArjunAutomations Demo — ' + $json.leadName, description: '20-minute ArjunAutomations discovery and product demo.\\nCompany: ' + $json.companyName + '\\nLead ID: ' + $json.leadId, start: { dateTime: $json.startAt, timeZone: 'Asia/Kolkata' }, end: { dateTime: $json.endAt, timeZone: 'Asia/Kolkata' }, attendees: $json.attendeeEmail ? [{ email: $json.attendeeEmail }] : [], conferenceData: { createRequest: { requestId: $execution.id.toString(), conferenceSolutionKey: { type: 'hangoutsMeet' } } } } }}",
        "options": {
          "timeout": 8000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
