      "position": [
        220,
        360
      ],
      "id": "6ebd87e7-2c6d-4d4d-9a1c-000000000001",
      "name": "Demo Booking Request",
      "credentials": {
        "httpHeaderAuth": {
          "id": "[CREATE_N8N_HEADER_AUTH_CREDENTIAL]",
          "name": "Priya Demo Booking Bearer"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body ?? $input.first().json;\nconst start = new Date(input.startAt);\nif (Number.isNaN(start.getTime())) throw new Error(\"Invalid startAt\");\nconst end = new Date(start.getTime() + 20 * 60 * 1000);\nconst timeMax = new Date(start.getTime() + 3 * 60 * 60 * 1000);\nreturn [{ json: {\n  leadId: input.leadId,\n  leadName: input.leadName || \"Prospect\",\n  companyName: input.companyName || \"\",\n  attendeeEmail: input.attendeeEmail || \"\",\n  attendeePhone: input.attendeePhone || \"\",\n  startAt: start.toISOString(),\n  endAt: end.toISOString(),\n  timeMin: start.toISOString(),\n  timeMax: timeMax.toISOString(),\n  timeZone: \"Asia/Kolkata\"\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        360
      ],
      "id": "6ebd87e7-2c6d-4d4d-9a1c-000000000002",
      "name": "Prepare IST Calendar Window"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "timeMin",
              "value": "={{$json.timeMin}}"
            },
            {
              "name": "timeMax",
              "value": "={{$json.timeMax}}"
            },
            {
              "name": "singleEvents",
              "value": "true"
            },
            {
              "name": "orderBy",
              "value": "startTime"
            }
          ]
        },
        "options": {
          "timeout": 8000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        360
      ],
      "id": "6ebd87e7-2c6d-4d4d-9a1c-000000000003",
      "name": "Read Google Calendar Events",
      "credentials": {
        "googleOAuth2Api": {
          "id": "[CREATE_GOOGLE_OAUTH2_CREDENTIAL]",
          "name": "Google Calendar OAuth2"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request = $(\"Prepare IST Calendar Window\").first().json;\nconst response = $input.first().json;\nconst events = Array.isArray(response.items) ? response.items : [];\nconst start = new Date(request.startAt);\nconst end = new Date(request.endAt);\nfunction overlaps(candidateStart, candidateEnd, event) {\n  const eventStart = new Date(event.start?.dateTime || event.start?.date).getTime();\n  const eventEnd = new Date(event.end?.dateTime || event.end?.date).getTime();\n  return Number.isFinite(eventStart) && Number.isFinite(eventEnd) &&\n    candidateStart.getTime() < eventEnd && candidateEnd.getTime() > eventStart;\n}\nconst available = !events.some(event => overlaps(start, end, event));\nconst alternatives = [];\nif (!available) {\n  for (let offset = 30; offset <= 180 && alternatives.length < 2; offset += 15) {\n    const candidateStart = new Date(start.getTime() + offset * 60000);\n    const candidateEnd = new Date(candidateStart.getTime() + 20 * 60000);\n    if (!events.some(event => overlaps(candidateStart, candidateEnd, event))) {\n      alternatives.push(candidateStart.toISOString());\n    }\n  }\n}\nreturn [{ json: { ...request, available, alternatives } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        360
      ],
      "id": "6ebd87e7-2c6d-4d4d-9a1c-000000000004",
      "name": "Find Available 20-Minute Slots"
    },
