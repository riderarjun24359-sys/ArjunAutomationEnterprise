      "name": "Create Google Meet Calendar Event",
      "credentials": {
        "googleOAuth2Api": {
          "id": "[CREATE_GOOGLE_OAUTH2_CREDENTIAL]",
          "name": "Google Calendar OAuth2"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $input.first().json;\nconst meetLink = event.hangoutLink || event.conferenceData?.entryPoints?.find(point => point.entryPointType === \"video\")?.uri || \"\";\nreturn [{ json: { status: \"booked\", eventId: event.id || \"\", meetLink, startAt: event.start?.dateTime || \"\", endAt: event.end?.dateTime || \"\" } }];"
      },
