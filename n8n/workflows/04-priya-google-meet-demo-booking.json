{
  "name": "Priya - Google Calendar 20-Minute Demo Booking",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "priya-demo-booking",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
