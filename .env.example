# Arjun Automation Enterprise - Environment Configuration Example
# Copy this file to .env.local and fill in your actual values
# NEVER commit real secrets to version control

# =============================================================================
# REQUIRED PUBLIC VARIABLES (Client-side, exposed to browser)
# =============================================================================

# Application URL (production canonical URL)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics & Tracking
#
# GA4 IS ALREADY CONFIGURED. The measurement ID is committed in
# src/config/analytics.ts because a GA4 ID is public (it ships in the page
# source of every GA4 site) and .env* is gitignored — an ID set only there
# would be missing from Vercel builds. Set the variable below ONLY to
# override it, e.g. so staging reports to a different property.
NEXT_PUBLIC_GA4_ID=G-1FBXBS641F
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GSC_VERIFICATION=your-google-site-verification-code
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=your-linkedin-partner-id

# =============================================================================
# PUBLIC BUSINESS IDENTITY  (src/config/company-profile.ts)
# =============================================================================
# Everything below is OPTIONAL, but each field you fill in switches on real UI
# across the whole site. Fields left blank are simply not rendered — we never
# print placeholder contact details on a live site.
#
#   NEXT_PUBLIC_COMPANY_PHONE  -> header click-to-call, footer, mobile menu,
#                                 and the floating WhatsApp button (the button
#                                 does not render at all until this is set)
#   NEXT_PUBLIC_COMPANY_ADDRESS_* -> footer address + Organization JSON-LD
#   NEXT_PUBLIC_COMPANY_GSTIN -> footer + schema.org `taxID`
#   NEXT_PUBLIC_SOCIAL_*       -> footer links + schema.org `sameAs`
#
# IMPORTANT: GSTIN and CIN are legal tax identifiers. Only enter real values
# from your registration documents — never a placeholder.
NEXT_PUBLIC_COMPANY_PHONE=+91 98765 43210
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Arjun Automation
NEXT_PUBLIC_COMPANY_ADDRESS_STREET=Your registered office street address
NEXT_PUBLIC_COMPANY_CITY=Your city
NEXT_PUBLIC_COMPANY_REGION=Your state
NEXT_PUBLIC_COMPANY_POSTAL_CODE=000000
NEXT_PUBLIC_COMPANY_COUNTRY=India
NEXT_PUBLIC_COMPANY_COUNTRY_CODE=IN
NEXT_PUBLIC_COMPANY_GSTIN=
NEXT_PUBLIC_COMPANY_CIN=
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/your-company
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-org
NEXT_PUBLIC_SOCIAL_X=https://x.com/yourhandle
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@yourchannel

# Stripe (Public key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# =============================================================================
# REQUIRED SERVER-SIDE SECRETS (Never exposed to browser)
# =============================================================================

# Platform API Keys (Internal service-to-service communication)
PLATFORM_LEAD_API_KEY=your-platform-lead-api-key
PLATFORM_ORGANIZATION_ID=your-organization-id

# Supabase Service Role (Admin access - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Provider - Choose ONE:
# Option A: Resend (Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=noreply@your-domain.com
# Owner inbox for new-lead alerts (fail-open: when unset or provider
# unconfigured, leads are still stored and the manual Supabase-dashboard
# fallback in marketing/leads/README.md applies).
# LEAD_OWNER_EMAIL=sales@your-domain.com

# Option B: SMTP (Alternative)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# NOTE: the code reads SMTP_PASS (see docs/GO_LIVE_CHECKLIST.md §6), not SMTP_PASSWORD.
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# Stripe Secret Key (KEEP SECRET)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# =============================================================================
# DATABASE CONNECTION (For migrations and scripts)
# =============================================================================

# Supabase Database URL (for running migrations)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
# OR use generic DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# OPTIONAL / ADVANCED CONFIGURATION
# =============================================================================

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Monitoring & Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Vercel Deployment (Optional - for CI/CD)
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id

# AI Providers (ALL OPTIONAL — local deterministic fallback is the default)
# The app builds, starts, and serves non-generative features with none of these set.
# Set a key ONLY to explicitly enable that external provider.
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# =============================================================================
# DEVELOPMENT OVERRIDES (Only for local development)
# =============================================================================

# Uncomment and modify for local development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# PLATFORM_LEAD_API_KEY=dev-platform-lead-key
# PLATFORM_ORGANIZATION_ID=dev-org-id